FROM clojure:temurin-26-tools-deps-alpine AS builder

RUN mkdir /app
WORKDIR /app
COPY . /app/
RUN make target/eduhub-rio-mapper-v6.jar target/opentelemetry-javaagent.jar

FROM gcr.io/distroless/java21-debian12:nonroot
COPY --from=builder /app/target/eduhub-rio-mapper-v6.jar /eduhub-rio-mapper-v6.jar
# Make sure there is an opentelemetry agent in the workdir in case docker-compose
# starts up a process with -javaagent in the JAVA_TOOL_OPTIONS
COPY --from=builder /app/target/opentelemetry-javaagent.jar /opentelemetry-javaagent.jar

WORKDIR /
ENTRYPOINT ["java", "-jar", "/eduhub-rio-mapper-v6.jar"]
