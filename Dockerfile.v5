FROM clojure:temurin-26-tools-deps-alpine AS builder

RUN mkdir /app
WORKDIR /app
COPY . /app/
RUN make target/eduhub-rio-mapper-v5.jar

FROM gcr.io/distroless/java21-debian12:nonroot
COPY --from=builder /app/target/eduhub-rio-mapper-v5.jar /eduhub-rio-mapper-v5.jar
# Make sure there is an opentelemetry agent in the workdir in case docker-compose
# starts up a process with -javaagent in the JAVA_TOOL_OPTIONS
COPY --from=builder /app/vendor/opentelemetry-javaagent-2.9.0.jar /opentelemetry-javaagent.jar

WORKDIR /

# "-XX:-UseBASE64Intrinsics" mitigates CVE-2026-114938 "Java4Shell"
ENTRYPOINT ["java", "-XX:-UseBASE64Intrinsics", "-jar", "/eduhub-rio-mapper-v5.jar"]

